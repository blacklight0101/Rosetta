# Rosetta server configuration (RF-1305). Copy to .env, which is git-ignored, and edit.
# Every value below is a placeholder. Real values come from your host's secret store or
# your local .env; never commit them. Empty values count as unset.

# PostgreSQL URL for the rosetta_app role, for running the server from source. Docker Compose sets
# its own database URLs from the passwords below and ignores this one. Add the role's password from ROSETTA_APP_DB_PASSWORD
# to the URL's user information in your own .env.
DATABASE_URL=postgres://rosetta_app@127.0.0.1:5432/rosetta

# Optional: URL for the rosetta_migrator role. DATABASE_URL is used when this is empty.
DATABASE_MIGRATOR_URL=

# Required: 32 random bytes, base64. Generate one with: openssl rand -base64 32
# The value below is an all-zero placeholder; the server refuses it (and any key of 32 equal bytes) at start-up.
ROSETTA_SECRET_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Optional: the previous key during a rotation; rows under it are re-encrypted at start-up.
ROSETTA_SECRET_KEY_PREVIOUS=

# Required: the address users open, an http(s) origin without a path. The Origin check compares with it.
ROSETTA_PUBLIC_URL=http://127.0.0.1:8080

# Required: the data folder for snapshots and run output (/data in the image).
ROSETTA_DATA_DIR=/data

# First start only: the bootstrap administrator (RF-1102).
ROSETTA_ADMIN_USER=admin
# First start only: the bootstrap administrator's password. Set it in your own .env.
ROSETTA_ADMIN_PASSWORD=

# Optional server keys for AI providers (DEC-64). Leave empty to use only users' own keys.
OPENAI_API_KEY=
# Optional server key for Anthropic.
ANTHROPIC_API_KEY=

# Optional: Ollama address. Set locally; leave empty when hosted.
ROSETTA_OLLAMA_URL=http://host.docker.internal:11434

# Optional: the address behind the landing page's "Request access" button.
ROSETTA_CONTACT_EMAIL=owner@example.com

# Log level: debug, info, warn or error.
ROSETTA_LOG_LEVEL=info

# Days to keep daily log files.
ROSETTA_LOG_RETENTION_DAYS=14

# Optional: raises GitHub rate limits for snapshot downloads (RF-123).
GITHUB_TOKEN=

# Number of proxy hops to trust for the client address: 0 locally, 1 behind the host's proxy.
ROSETTA_TRUST_PROXY=0

# Scan-wide parse budget of the language packs, in milliseconds: a whole number from 1 to 3600000.
# Empty means the default, 120000 (two minutes). Files past the budget stay coarse with a notice.
ROSETTA_SCAN_PARSE_BUDGET_MS=

# Local Compose only: the password of the rosetta_app role, read by the init script that creates
# the database roles. Set it in your own .env.
ROSETTA_APP_DB_PASSWORD=
# Local Compose only: the password of the rosetta_migrator role. Set it in your own .env.
ROSETTA_MIGRATOR_DB_PASSWORD=
# Local Compose only: the password of the image's bootstrap superuser postgres, used by the db
# service to initialise an empty volume. Set it in your own .env.
ROSETTA_DB_ADMIN_PASSWORD=

# Tests only: 1 enables the fake provider and fake GitHub. Refused when ROSETTA_PUBLIC_URL is https.
ROSETTA_TEST=

# Tests only: the disposable PostgreSQL for integration tests. Refused when ROSETTA_PUBLIC_URL is https.
ROSETTA_TEST_DATABASE_URL=
