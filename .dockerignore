# Keeps secrets, history, local output and tooling out of the build context (RF-1300, RNF-003).
.env
.env.*
.git
.github
.claude
.impeccable
node_modules
**/node_modules
dist
coverage
test-results
playwright-report
rosetta-out
_legacy
eval-out
**/*.map
**/*.tsbuildinfo
**/*.log
docs
eval
*.md
Dockerfile
.dockerignore
compose*.yaml

# Lint, format, hook and dead-code configuration is not needed to build or run.
.dependency-cruiser.cjs
.editorconfig
.prettierignore
.prettierrc
.gitattributes
.gitignore
.nvmrc
audit-exceptions.json
commitlint.config.ts
eslint.config.ts
knip.json
lefthook.yml
web-lint.config.ts
