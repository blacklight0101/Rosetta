{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": ["tree-sitter-c-sharp"],
  "entry": [
    "src/presentation/main.ts",
    "src/presentation/migrate.ts",
    "scripts/*.mjs",
    "tests/**/*.test.ts",
    "src/infrastructure/files/grep-worker.ts",
    "tests/compose/*.spec.ts",
    "tests/compose/serve.ts",
    "tests/support/frozen-database-harness.ts",
    "tests/support/read-project-child.ts",
    "tests/support/dependency-child.ts",
    "tests/support/text-cap-child.ts"
  ],
  "project": [
    "src/**/*.ts",
    "eval/**/*.ts",
    "tests/**/*.{ts,tsx}",
    "scripts/**/*.mjs",
    "web/**/*.{ts,tsx}"
  ]
}
