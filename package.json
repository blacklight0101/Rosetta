{
  "name": "rosetta",
  "version": "0.0.0",
  "description": "Turns a legacy codebase into a verified functional specification and a modernisation hand-off package.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build --config web/vite.config.ts",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "dev:web": "vite --config web/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "arch": "depcruise src tests web --config .dependency-cruiser.cjs",
    "deadcode": "knip",
    "test": "vitest run",
    "test:ci": "vitest run --coverage && node scripts/test-levels.mjs",
    "test:levels": "node scripts/test-levels.mjs",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run arch && npm run deadcode && npm run test:ci",
    "live:openai": "npm run build && node scripts/openai-live-check.mjs",
    "live:ollama": "npm run build && node scripts/ollama-live-check.mjs",
    "hooks:install": "lefthook install"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "2.10.6",
    "@testing-library/preact": "3.2.4",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/eslint-plugin": "^1.6.27",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.4.1",
    "happy-dom": "20.14.5",
    "knip": "^6.41.0",
    "lefthook": "^2.2.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "8.3.1",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/csrf-protection": "8.0.1",
    "@fastify/helmet": "^13.1.2",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "^10.1.6",
    "fastify": "^5.12.5",
    "ignore": "^7.0.12",
    "openai": "^7.32.0",
    "pg": "^8.23.1",
    "preact": "10.29.8",
    "tar": "^7.5.22",
    "tree-sitter-c-sharp": "^0.23.5",
    "web-tree-sitter": "^0.27.1",
    "zod": "^4.6.5"
  }
}
